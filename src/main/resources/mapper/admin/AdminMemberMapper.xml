<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.all_my_trip_project.domain.admin.mapper.AdminMemberMapper">

    <!--
      password_hash는 어떤 조회에서도 뽑지 않는다. 화면이 쓰지 않는 값이고, 한 번 DTO에
      올라오면 응답이나 로그로 새어 나갈 길이 생긴다.
    -->
    <sql id="memberColumns">
        user_id, email, nickname, role, status, last_login_at, created_at, deleted_at
    </sql>

    <!--
      탈퇴 회원은 기본으로 뺀다. 목록에서 가장 많은 자리를 차지하면서 정지도 승격도 할 수
      없는 행이라, 매번 눈으로 걸러내야 한다. 상태 필터로 WITHDRAWN을 직접 고를 때만 나온다.

      email은 CITEXT라 ILIKE 없이도 대소문자를 가리지 않지만, nickname은 VARCHAR라 필요하다.
      두 칸을 같은 키워드로 훑으므로 양쪽 모두 ILIKE로 맞춘다.
    -->
    <sql id="memberFilter">
        <if test="!includeWithdrawn">
            AND status &lt;&gt; 'WITHDRAWN'
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="role != null and role != ''">
            AND role = #{role}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (nickname ILIKE '%' || #{keyword} || '%' OR email ILIKE '%' || #{keyword} || '%')
        </if>
    </sql>

    <select id="findPage" resultType="org.example.all_my_trip_project.domain.admin.dto.AdminMemberDTO">
        SELECT <include refid="memberColumns"/>
        FROM users
        WHERE 1 = 1
        <include refid="memberFilter"/>
        ORDER BY created_at DESC, user_id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM users
        WHERE 1 = 1
        <include refid="memberFilter"/>
    </select>

    <select id="findById" resultType="org.example.all_my_trip_project.domain.admin.dto.AdminMemberDTO">
        SELECT <include refid="memberColumns"/>
        FROM users
        WHERE user_id = #{userId}
    </select>

    <!-- 화면이 "마지막 관리자"를 미리 알아보려고 읽는다. 잠그지 않는 가벼운 조회다. -->
    <select id="countActiveAdmins" resultType="long">
        SELECT COUNT(*)
        FROM users
        WHERE role = 'ADMIN' AND status = 'ACTIVE' AND deleted_at IS NULL
    </select>

    <!--
      정지되었거나 탈퇴한 관리자는 세지 않는다. 로그인을 못 하므로 남아 있어도 /admin에
      들어갈 사람이 없다. "관리자가 하나 더 있다"가 참이려면 그 사람이 실제로 들어갈 수
      있어야 한다.

      FOR UPDATE는 집계와 같은 단계에 쓸 수 없어 서브쿼리로 감쌌다. 바깥 COUNT는 이미
      잠긴 행을 셀 뿐이다.
    -->
    <select id="lockAndCountActiveAdmins" resultType="long">
        SELECT COUNT(*) FROM (
            SELECT user_id
            FROM users
            WHERE role = 'ADMIN' AND status = 'ACTIVE' AND deleted_at IS NULL
            FOR UPDATE
        ) locked_admins
    </select>

    <!--
      탈퇴 회원은 UPDATE 단계에서도 막는다. 서비스가 이미 걸러내지만, 이 두 문장은 회원의
      권한과 접근을 직접 바꾸는 자리라 한 겹 더 둔다.
    -->
    <update id="updateStatus">
        UPDATE users
        SET status = #{status}
        WHERE user_id = #{userId}
          AND status &lt;&gt; 'WITHDRAWN'
          AND deleted_at IS NULL
    </update>

    <update id="updateRole">
        UPDATE users
        SET role = #{role}
        WHERE user_id = #{userId}
          AND status &lt;&gt; 'WITHDRAWN'
          AND deleted_at IS NULL
    </update>

</mapper>
