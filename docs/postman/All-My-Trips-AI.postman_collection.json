{
  "info": {
    "name": "All My Trips - AI Guide",
    "description": "AI Guide API collection. Authenticate first, call GET /api/v1/csrf, then send the returned token in the configured CSRF header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "tripId", "value": "1" },
    { "key": "tripDayId", "value": "1" },
    { "key": "timeConflictPlaceId", "value": "999999" },
    { "key": "csrfHeaderName", "value": "X-CSRF-TOKEN" },
    { "key": "csrfToken", "value": "" }
  ],
  "item": [
    {
      "name": "Get CSRF token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const payload = pm.response.json();",
              "pm.collectionVariables.set('csrfHeaderName', payload.headerName);",
              "pm.collectionVariables.set('csrfToken', payload.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/csrf", "host": ["{{baseUrl}}"], "path": ["api", "v1", "csrf"] }
      }
    },
    {
      "name": "Generate guide with owned trip",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "{{csrfHeaderName}}", "value": "{{csrfToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"tripId\": {{tripId}},\n  \"question\": \"Recommend dinner that fits my current itinerary\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/ai-guides/generate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ai-guides", "generate"] }
      }
    },
    {
      "name": "Reset current trip AI conversation",
      "description": "Archives the active DB conversation while removing only the current user/trip Redis history. Login and a CSRF token are required.",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "{{csrfHeaderName}}", "value": "{{csrfToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/ai-guides/conversation?tripId={{tripId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ai-guides", "conversation"], "query": [{ "key": "tripId", "value": "{{tripId}}" }] }
      }
    },
    {
      "name": "Time conflict - expects 409 ITINERARY_TIME_CONFLICT",
      "description": "Before running, set tripDayId to a DAY that already has an item occupying 10:00-12:00 (or an item with startTime 10:00 and no endTime). Set timeConflictPlaceId to a different verified place ID. The AI source causes the server-side time conflict validation to run.",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns 409', () => pm.response.to.have.status(409));",
              "pm.test('code is ITINERARY_TIME_CONFLICT', () => pm.expect(pm.response.json().code).to.eql('ITINERARY_TIME_CONFLICT'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "{{csrfHeaderName}}", "value": "{{csrfToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"placeId\": {{timeConflictPlaceId}},\n  \"itemType\": \"PLACE\",\n  \"title\": \"AI 시간 충돌 검증 장소\",\n  \"startTime\": \"11:00\",\n  \"source\": \"AI\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/trip-days/{{tripDayId}}/items", "host": ["{{baseUrl}}"], "path": ["api", "v1", "trip-days", "{{tripDayId}}", "items"] }
      }
    },
    {
      "name": "Validation error - missing tripId",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "{{csrfHeaderName}}", "value": "{{csrfToken}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"question\": \"Recommend dinner\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/ai-guides/generate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ai-guides", "generate"] }
      }
    },
    {
      "name": "Trip not found or not owned",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "{{csrfHeaderName}}", "value": "{{csrfToken}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"tripId\": 999999999,\n  \"question\": \"Recommend dinner\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/ai-guides/generate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ai-guides", "generate"] }
      }
    },
    {
      "name": "Unauthenticated - expects 401",
      "description": "Send a valid CSRF token without logging in. CSRF passes, authentication fails, so the response is 401 UNAUTHORIZED. Clear the session cookie before running.",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns 401', () => pm.response.to.have.status(401));",
              "pm.test('code is UNAUTHORIZED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "{{csrfHeaderName}}", "value": "{{csrfToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"tripId\": {{tripId}},\n  \"question\": \"Recommend dinner\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/ai-guides/generate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ai-guides", "generate"] }
      }
    },
    {
      "name": "Missing CSRF token - expects 403",
      "description": "CsrfFilter runs before ExceptionTranslationFilter and answers with its own handler, so a missing token is 403 regardless of login state - never 401.",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('returns 403', () => pm.response.to.have.status(403));"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"tripId\": {{tripId}},\n  \"question\": \"Recommend dinner\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/ai-guides/generate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ai-guides", "generate"] }
      }
    },
    {
      "name": "Members me - unauthenticated expects 401",
      "description": "GET requests skip CSRF, so this returns 401 directly and is the simplest way to confirm the auth failure body format.",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns 401', () => pm.response.to.have.status(401));",
              "pm.test('body matches ErrorResponse', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b.success).to.eql(false);",
              "  pm.expect(b.code).to.eql('UNAUTHORIZED');",
              "  pm.expect(b.data).to.eql(null);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/members/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "members", "me"] }
      }
    }
  ]
}
